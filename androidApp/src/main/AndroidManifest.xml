<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- From target SDK 37, reaching a private address such as the emulator's 10.0.2.2 needs this. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Flight Explorer"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlightExplorer">
        <!-- Portrait on phones, where landscape leaves no height for results. Android ignores this on
             large screens, so configChanges still matters: Compose handles these without a restart,
             while rebuilding the activity would rebuild the native map, losing the camera and, as
             measured, ~4 MB of native heap each time. uiMode is left out so that a theme switch still
             restarts into the matching map style. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
